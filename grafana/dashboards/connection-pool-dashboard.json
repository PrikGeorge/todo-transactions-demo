{
  "uid": "hikari-bar",
  "title": "Bar 'U Hikari' - Connection Pool",
  "tags": ["hikari", "transactions", "spring-boot"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Connection Pool State",
      "description": "active = столики заняты, pending = очередь у входа. pending > 0 - плохой знак.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 },
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "pending" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "max" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{pool=\"TodoHikariPool\"}",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_idle{pool=\"TodoHikariPool\"}",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_pending{pool=\"TodoHikariPool\"}",
          "legendFormat": "pending"
        },
        {
          "refId": "D",
          "expr": "hikaricp_connections_max{pool=\"TodoHikariPool\"}",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Threads Awaiting Connection",
      "description": "Очередь у входа прямо сейчас",
      "gridPos": { "h": 9, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_pending{pool=\"TodoHikariPool\"}",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Connection Timeouts (per minute)",
      "description": "Каждая точка выше нуля - поток, который ждал 5 секунд и получил исключение",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60 },
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(hikaricp_connections_timeout_total{pool=\"TodoHikariPool\"}[1m])",
          "legendFormat": "timeouts"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Avg Connection Acquire Time",
      "description": "Сколько ждали соединение. В здоровом пуле - микросекунды.",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hikaricp_connections_acquire_seconds_sum{pool=\"TodoHikariPool\"}[1m]) / rate(hikaricp_connections_acquire_seconds_count{pool=\"TodoHikariPool\"}[1m])",
          "legendFormat": "acquire avg"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Avg Connection Usage Time",
      "description": "Сколько соединение держат после получения. Растёт при медленных транзакциях и утечках.",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hikaricp_connections_usage_seconds_sum{pool=\"TodoHikariPool\"}[1m]) / rate(hikaricp_connections_usage_seconds_count{pool=\"TodoHikariPool\"}[1m])",
          "legendFormat": "usage avg"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP p99 Latency (что чувствует пользователь)",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])) by (le))",
          "legendFormat": "p99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])) by (le))",
          "legendFormat": "p50"
        }
      ]
    }
  ]
}
